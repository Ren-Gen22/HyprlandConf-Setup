### Games ###
for_window [class="steam"] fullscreen enable
for_window [class="steam"] floating disable

### Borders and Gaps ###
client.focused          $lavender $base $text  $rosewater $lavender
client.focused_inactive $surface1 $base $text  $surface1  $surface1
client.unfocused        $surface0 $base $text  $surface0  $surface0
client.urgent           $red      $base $red   $red       $red

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

gaps inner 2
gaps outer 2
smart_gaps on

### System Mode ###
mode "system" {
    bindsym l exec $lock, mode "default"
    bindsym h exec systemctl suspend, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym s exec systemctl poweroff, mode "default"
    bindsym Escape mode "default"
    bindsym Return mode "default"
    # Optional: You can also show a notification here, but it won't trigger just by mode activation
    bindsym n exec --no-startup-id notify-send "Sys Mode Active"
}
bindsym $mod+x exec --no-startup-id notify-send "Sys Mode Active"; mode "system"

### Resize
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    # Exit resize mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym n exec --no-startup-id notify-send "Resize Mode Active"
}

bindsym $mod+r exec --no-startup-id notify-send "Resize Mode Active"; mode "resize"
### Reload / Restart ###
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

